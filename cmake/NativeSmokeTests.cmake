if(NOT SYNTH1X_BUILD_IPLUG2)
    message(FATAL_ERROR "Native audio smoke tests require SYNTH1X_BUILD_IPLUG2=ON")
endif()
add_executable(Synth1XAudioSmoke tests/native/AudioSmoke.cpp)
target_compile_features(Synth1XAudioSmoke PRIVATE cxx_std_20)
target_compile_definitions(Synth1XAudioSmoke PRIVATE $<$<CONFIG:Debug>:DEVELOPMENT=1> $<$<NOT:$<CONFIG:Debug>>:RELEASE=1>)
target_include_directories(Synth1XAudioSmoke PRIVATE
    "${IPLUG2_DIR}/Dependencies/IPlug/VST3_SDK"
    "${IPLUG2_DIR}/Dependencies/IPlug/CLAP_SDK/include")
target_link_libraries(Synth1XAudioSmoke PRIVATE Synth1XCore ${CMAKE_DL_LIBS})
if(APPLE)
    target_link_libraries(Synth1XAudioSmoke PRIVATE "-framework AudioToolbox" "-framework CoreFoundation")
endif()
foreach(format vst3 clap au)
    if(TARGET Synth1X-${format})
        if(format STREQUAL "vst3")
            target_sources(Synth1XAudioSmoke PRIVATE tests/native/Vst3Host.cpp)
        elseif(format STREQUAL "clap")
            target_sources(Synth1XAudioSmoke PRIVATE tests/native/ClapHost.cpp)
        else()
            target_sources(Synth1XAudioSmoke PRIVATE tests/native/AuHost.cpp)
        endif()
        string(TOUPPER ${format} upper_format)
        target_compile_definitions(Synth1XAudioSmoke PRIVATE SYNTH1X_SMOKE_${upper_format}=1)
        set(synth1x_has_smoke_format TRUE)
        add_dependencies(Synth1XAudioSmoke Synth1X-${format})
        add_test(NAME NativeAudioSmoke-${format} COMMAND Synth1XAudioSmoke
            ${format} "$<TARGET_FILE:Synth1X-${format}>" "${CMAKE_CURRENT_SOURCE_DIR}/tests/native/patches")
        set_tests_properties(NativeAudioSmoke-${format} PROPERTIES LABELS "native;smoke" TIMEOUT 60)
    endif()
endforeach()
if(NOT synth1x_has_smoke_format)
    message(FATAL_ERROR "Native audio smoke tests require at least one plugin format (VST3, CLAP or AU)")
endif()
