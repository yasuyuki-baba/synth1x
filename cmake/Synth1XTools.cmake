# Public Python tests render with Probe and inspect WAVs with CompareWaves.
# Keep these test dependencies available even when optional tools are disabled.
add_executable(Synth1XProbe tools/synth1x_probe.cpp)
target_link_libraries(Synth1XProbe PRIVATE Synth1XCore)
add_executable(CompareWaves tools/compare_waves.cpp)
target_include_directories(CompareWaves PRIVATE projects/Synth1X/src)
set(synth1x_tool_targets Synth1XProbe CompareWaves)

if(SYNTH1X_BUILD_TOOLS)
    # Deliberately excluded from normal builds and never linked into native products.
    synth1x_add_core(Synth1XDiagnosticCore EXCLUDE_FROM_ALL)
    target_compile_definitions(Synth1XDiagnosticCore PUBLIC SYNTH1X_OFFLINE_DIAGNOSTICS=1)
    add_executable(Synth1XDiagnosticProbe EXCLUDE_FROM_ALL tools/synth1x_probe.cpp)
    target_link_libraries(Synth1XDiagnosticProbe PRIVATE Synth1XDiagnosticCore)
    list(APPEND synth1x_tool_targets Synth1XDiagnosticProbe)
    add_executable(Synth1XRenderProfile tools/profile_render.cpp)
    target_link_libraries(Synth1XRenderProfile PRIVATE Synth1XCore)
    list(APPEND synth1x_tool_targets Synth1XRenderProfile)
    add_executable(Synth1XLoadingProbe tools/synth1x_loading_probe.cpp)
    target_link_libraries(Synth1XLoadingProbe PRIVATE Synth1XCore)
    add_executable(Synth1XHostBenchmark tools/synth1x_host_benchmark.cpp)
    target_link_libraries(Synth1XHostBenchmark PRIVATE Synth1XCore)
    add_executable(Synth1XTagProbe tools/tag_probe.cpp)
    target_link_libraries(Synth1XTagProbe PRIVATE Synth1XCore)
    list(APPEND synth1x_tool_targets Synth1XLoadingProbe
        Synth1XHostBenchmark Synth1XTagProbe)
endif()
foreach(target IN LISTS synth1x_tool_targets)
    target_compile_features(${target} PRIVATE cxx_std_20)
    set_target_properties(${target} PROPERTIES CXX_EXTENSIONS OFF)
endforeach()
