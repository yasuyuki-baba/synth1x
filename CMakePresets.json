{
  "version": 6,
  "configurePresets": [
    {
      "name": "core",
      "displayName": "Portable DSP and tests (no plugin SDK)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SYNTH1X_BUILD_IPLUG2": "OFF",
        "SYNTH1X_BUILD_TESTS": "ON",
        "SYNTH1X_BUILD_TOOLS": "ON"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows VST3 / CLAP",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "SYNTH1X_BUILD_IPLUG2": "ON",
        "SYNTH1X_BUILD_TESTS": "OFF",
        "SYNTH1X_IPLUG2_FORMATS": "VST3;CLAP",
        "SYNTH1X_BUILD_TOOLS": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-ci",
      "displayName": "Windows MSVC x64 CI (Ninja)",
      "inherits": "windows",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "windows-app",
      "inherits": "windows",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "SYNTH1X_IPLUG2_FORMATS": "APP"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS VST3 / CLAP / AUv2 (Apple Silicon)",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "SYNTH1X_BUILD_IPLUG2": "ON",
        "SYNTH1X_BUILD_TESTS": "OFF",
        "SYNTH1X_IPLUG2_FORMATS": "VST3;CLAP;AU",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "IPLUG2_UNIVERSAL": "OFF",
        "SYNTH1X_BUILD_TOOLS": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-ci",
      "displayName": "macOS Apple Silicon CI (Ninja)",
      "inherits": "macos",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-app",
      "displayName": "macOS standalone (Apple Silicon)",
      "inherits": "macos",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "SYNTH1X_IPLUG2_FORMATS": "APP"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux VST3 / CLAP (experimental iPlug2 branch)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SYNTH1X_BUILD_IPLUG2": "ON",
        "SYNTH1X_BUILD_TESTS": "OFF",
        "SYNTH1X_IPLUG2_FORMATS": "VST3;CLAP",
        "IGRAPHICS_BACKEND": "NANOVG",
        "IGRAPHICS_RENDERER": "GL3",
        "SYNTH1X_BUILD_TOOLS": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-app",
      "displayName": "Linux standalone (experimental iPlug2 branch)",
      "inherits": "linux",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "SYNTH1X_IPLUG2_FORMATS": "APP"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "core",
      "configurePreset": "core"
    },
    {
      "name": "windows",
      "configurePreset": "windows",
      "configuration": "Release",
      "targets": [
        "Synth1X-vst3",
        "Synth1X-clap"
      ]
    },
    {
      "name": "windows-app",
      "configurePreset": "windows-app",
      "configuration": "Release",
      "targets": [
        "Synth1X-app"
      ]
    },
    {
      "name": "macos",
      "configurePreset": "macos",
      "configuration": "Release",
      "targets": [
        "Synth1X-vst3",
        "Synth1X-clap",
        "Synth1X-au"
      ]
    },
    {
      "name": "macos-app",
      "configurePreset": "macos-app",
      "configuration": "Release",
      "targets": [
        "Synth1X-app"
      ]
    },
    {
      "name": "linux",
      "configurePreset": "linux",
      "targets": [
        "Synth1X-vst3",
        "Synth1X-clap"
      ]
    },
    {
      "name": "linux-app",
      "configurePreset": "linux-app",
      "targets": [
        "Synth1X-app"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "core",
      "configurePreset": "core",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
