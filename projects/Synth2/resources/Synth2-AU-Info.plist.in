<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AudioComponents</key>
	<array>
		<dict>
			<key>description</key>
			<string>Synth1X</string>
			<key>factoryFunction</key>
			<string>Synth2_Factory</string>
			<key>manufacturer</key>
			<string>BABA</string>
			<key>name</key>
			<string>babab: Synth1X</string>
			<key>sandboxSafe</key>
			<true/>
			<key>subtype</key>
			<string>Sy1X</string>
			<key>type</key>
			<string>aumu</string>
			<key>version</key>
			<integer>@SYNTH2_VERSION_NUMBER@</integer>
		</dict>
	</array>
	<key>AudioUnit Version</key>
	<string>@SYNTH2_VERSION_HEX@</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleExecutable</key>
	<string>Synth1X</string>
	<key>CFBundleGetInfoString</key>
	<string>Synth1X v@SYNTH2_BUILD_VERSION@ Copyright 2026 Synth1X contributors</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.yasuyuki-baba.audiounit.Synth2</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Synth1X</string>
	<key>CFBundlePackageType</key>
	<string>BNDL</string>
	<key>CFBundleShortVersionString</key>
	<string>@SYNTH2_NUMERIC_VERSION@</string>
	<key>CFBundleSignature</key>
	<string>Sy1X</string>
	<key>CFBundleVersion</key>
	<string>@SYNTH2_NUMERIC_VERSION@</string>
	<key>CSResourcesFileMapped</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>NSPrincipalClass</key>
	<string>Synth2_View</string>
</dict>
</plist>
